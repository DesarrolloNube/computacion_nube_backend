{
  "name": "Backend (FastAPI)",
  "dockerComposeFile": ["../../docker-compose.yml"],
  "service": "backend",
  "runServices": ["backend", "db"],
  "workspaceFolder": "/app",
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
